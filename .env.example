# Copy to .env and adjust values for your server.

# Postgres bootstrap
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me_strong_password

# MinIO bootstrap (must match values used by app containers)
MINIO_ROOT_USER=change_me_minio_access_key
MINIO_ROOT_PASSWORD=change_me_minio_secret_key

# Shared app connections
AEGIS_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=aegis;Username=aegis;Password=change_me_strong_password
AEGIS_REDIS_CONNECTION_STRING=redis:6379
AEGIS_ZONETREE_PATH=/data/zonetree/messages-db

# MinIO storage settings
AEGIS_MINIO_ENDPOINT=minio:9000
AEGIS_MINIO_BUCKET=aegis-media
AEGIS_MINIO_PUBLIC_BASE_URL=http://95.215.56.43:9000

# User search index (Elasticsearch)
AEGIS_ELASTICSEARCH_ENDPOINT=http://elasticsearch:9200
AEGIS_ELASTICSEARCH_INDEX=aegis-users

# Public URL for avatar links (used by server response payloads)
#AEGIS_AVATAR_PUBLIC_BASE_URL=https://your-domain.example/media/avatars
AEGIS_AVATAR_PUBLIC_BASE_URL=http://95.215.56.43:5000/media/avatars

# Security toggle for protocol payloads after handshake
AEGIS_REQUIRE_ENCRYPTED_PAYLOAD_AFTER_HANDSHAKE=true
AEGIS_REQUIRE_APP_CREDENTIALS=true
# Server-side handshake response signing key.
# Required only when AEGIS_REQUIRE_SIGNED_HANDSHAKE_RESPONSES=true.
AEGIS_HANDSHAKE_SIGNING_PRIVATE_KEY_BASE64=
# Public verification key for clients/tools that validate signed handshake responses.
# Not consumed by the server directly and does not replace AppId/AppHash.
AEGIS_HANDSHAKE_SIGNING_PUBLIC_KEY_BASE64=
