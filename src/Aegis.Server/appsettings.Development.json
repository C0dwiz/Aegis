{
  "Server": {
    "Port": 8888,
    "MaxConnections": 10000,
    "BufferSize": 8192,
    "EnableIPv6": true,
    "IdleTimeoutSeconds": 300,
    "GracefulShutdownTimeoutSeconds": 30
  },
  "Crypto": {
    "EncryptionKeySize": 32,
    "MacKeySize": 32,
    "NonceSize": 12,
    "TagSize": 16
  },
  "RateLimit": {
    "MaxAuthAttemptsPerMinute": 5,
    "MaxMessagesPerSecond": 100,
    "MaxConnectionsPerIP": 10
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=aegis.db;Cache=Shared"
  },
  "Logging": {
    "MinimumLevel": "Information",
    "Console": true,
    "File": true,
    "FilePath": "logs/aegis-{Date}.log"
  }
}